# .env.example — copy to .env for local development (never commit .env)
# For production on Render, set these in the Render Dashboard → Environment tab
# (or they are auto-set by render.yaml)

# Django core
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=your-local-dev-secret-key-change-me
DEBUG=True

# Allowed hosts (comma-separated, no spaces)
# Leave empty for development (development.py uses ['*'])
ALLOWED_HOSTS=

# Database — leave empty to use SQLite in development
# On Render, DATABASE_URL is automatically set from the linked PostgreSQL service
DATABASE_URL=

# Logging level
DJANGO_LOG_LEVEL=INFO
